{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTune",
  "version": "0.6.0",
  "identifier": "org.opentune.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenTune — early alpha",
        "width": 1120,
        "height": 760,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "app", "dmg", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Open ECU identify / checksum / calibration",
    "longDescription": "OpenTune — the open-source, calibration-only ECU toolkit. Offline identify, checksum verify/fix, map diff + heat-view, and a safety-gated (mock) flash on flash-image files. Hardware drivers (OpenPort 2.0, SocketCAN, SLCAN, K-line) ship for live reads/flashes.",
    "resources": {
      "../../ecudefs": "ecudefs",
      "../../catalog": "catalog",
      "../../database": "database",
      "../../packs": "packs",
      "../../ctrldefs": "ctrldefs",
      "guide": "guide"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ebjerk01/opentune/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNzNFRTkzNkVEQTJDNzYKUldSMkxOcHVrKzV6d3RRV1pZeFJiVnFOZWp0YlZhQk1SMmJ6cHJQUGZ2Zk9DTm0waU9BRkJOa1kK"
    }
  }
}
