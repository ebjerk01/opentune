{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ebjerk01/opentune/docs/database-unit.schema.json",
  "title": "OpenTune control-unit database record (database/units/<id>.json)",
  "description": "One ECU / TCU / AWD family or variant. Rules beyond this schema (source counts, bench wiring honesty) are enforced by opentune-db's validator; see docs/DATABASE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "kind", "maker", "family", "name", "cpu", "flash_kib", "eeprom", "bus", "protocols",
    "read_methods", "checksum", "ecudef", "vehicles", "part_number_examples", "notes",
    "connectors", "bench", "pinout_confidence", "safety_note", "sources"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Unique; equals the file name without .json." },
    "kind": { "enum": ["ecu", "tcu", "awd"] },
    "maker": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "cpu": { "type": ["string", "null"], "description": "Processor, e.g. MPC562, TC1796, C167CR. null when no source states it." },
    "flash_kib": { "type": ["integer", "null"], "minimum": 1 },
    "flash_note": { "type": "string", "minLength": 1, "description": "Optional caveat on the flash size, e.g. '29F400 (512 KiB) or 29F800 (1 MiB) by revision - confirm from the chip'." },
    "eeprom": { "type": ["string", "null"] },
    "bus": { "type": "array", "minItems": 1, "items": { "enum": ["can", "kline"] } },
    "protocols": { "type": "array", "items": { "enum": ["kwp2000", "uds", "tp20", "kwp1281"] } },
    "read_methods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obd", "bench", "boot", "notes"],
      "properties": {
        "obd": { "enum": ["read+write", "read", "write-only", "none", "unknown"], "description": "'read' = complete read over OBD, no programming. 'unknown' = no public source either way (never guessed). Must equal access.obd.mode." },
        "bench": { "type": "boolean" },
        "boot": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "checksum": { "type": ["string", "null"], "description": "An opentune_checksum::get() id (edc15, edc15c6, edc16, edc17, pcr21, me7, dq250, dq250-02e, dq381, zf8hp, haldex, tcu-ccitt, simos-crc, crc32-tail) or null." },
    "ecudef": { "type": ["string", "null"], "description": "The id of a definition in ecudefs/, or null." },
    "vehicles": { "type": "array", "items": { "$ref": "#/$defs/vehicle" } },
    "part_number_examples": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string", "minLength": 1, "description": "Must explain a missing pinout when connectors is empty." },
    "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } },
    "bench": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bench" }] },
    "pinout_confidence": { "enum": ["verified", "community", "unverified", null] },
    "safety_note": { "type": ["string", "null"], "description": "Required whenever a pinout is given." },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "access": { "$ref": "#/$defs/access", "description": "Access profile (docs/UNIT-ACCESS-PROFILE.md). Required for every unit not listed in database/units/.access-pending." }
  },
  "$defs": {
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["make", "model"],
      "properties": {
        "make": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "engine": { "type": ["string", "null"] },
        "years": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pin", "function", "signal", "sources"],
      "properties": {
        "pin": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "signal": { "enum": ["12v_perm", "12v_ign", "gnd", "can_h", "can_l", "kline", "boot", "other"] },
        "note": { "type": ["string", "null"] },
        "confidence": { "enum": ["verified", "community", "unverified", null], "description": "Defaults to the unit's pinout_confidence. 'verified' needs 2+ distinct sources." },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "description": "Indices into the unit's sources." },
        "strap": { "$ref": "#/$defs/strap", "description": "Only on signal 'boot' pins." }
      }
    },
    "strap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "$ref": "#/$defs/strap_action" },
        "resistor_ohms": { "type": "integer", "minimum": 1 }
      }
    },
    "strap_action": { "enum": ["pull-to-gnd", "pull-to-vcc", "bridge", "connect"] },
    "confidence": { "enum": ["verified", "community", "unverified"], "description": "As for pins: 'verified' needs 2+ distinct sources." },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "description": "Indices into the unit's sources." },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the unit is reached. There is deliberately no field for key, seed or algorithm material.",
      "required": ["obd", "bench", "boot", "security"],
      "properties": {
        "obd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "notes", "confidence", "sources"],
          "properties": {
            "mode": { "enum": ["read+write", "read", "write-only", "none", "unknown"], "description": "Must equal read_methods.obd." },
            "protocol": { "type": ["string", "null"] },
            "notes": { "type": "string", "minLength": 1 },
            "confidence": { "$ref": "#/$defs/confidence" },
            "sources": { "$ref": "#/$defs/source_refs" }
          }
        },
        "bench": {
          "type": "object",
          "additionalProperties": false,
          "required": ["possible", "how", "confidence", "sources"],
          "properties": {
            "possible": { "oneOf": [{ "type": "boolean" }, { "const": "unknown" }], "description": "true / false / \"unknown\" (not documented). true must match read_methods.bench = true; false and \"unknown\" match false." },
            "how": { "type": "string", "minLength": 1 },
            "confidence": { "$ref": "#/$defs/confidence" },
            "sources": { "$ref": "#/$defs/source_refs" }
          }
        },
        "boot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["possible", "entry", "reachable", "notes", "confidence", "sources"],
          "properties": {
            "possible": { "oneOf": [{ "type": "boolean" }, { "const": "unknown" }], "description": "true: documented route (1+ point, a known entry, reachable not unknown). false: a source says there is none (entry none, no points, reachable unknown). \"unknown\": not documented (entry unknown, no points, reachable unknown). true must match read_methods.boot = true; the others match false." },
            "entry": { "enum": ["connector-pin", "board-pad", "bdm-jtag", "none", "unknown"] },
            "mcu_mode": { "type": ["string", "null"] },
            "points": { "type": "array", "items": { "$ref": "#/$defs/boot_point" } },
            "reset_timing": { "type": ["string", "null"] },
            "reachable": { "enum": ["external-connector", "open-case", "unknown"] },
            "notes": { "type": "string", "minLength": 1 },
            "confidence": { "$ref": "#/$defs/confidence" },
            "sources": { "$ref": "#/$defs/source_refs" }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diag_read", "flash_write", "notes", "confidence", "sources"],
          "properties": {
            "diag_read": { "enum": ["required", "not-required", "unknown"] },
            "flash_write": { "enum": ["required", "not-required", "unknown"] },
            "notes": { "type": "string", "minLength": 1, "description": "Must contain 'OpenTune ships no OEM key'." },
            "confidence": { "$ref": "#/$defs/confidence" },
            "sources": { "$ref": "#/$defs/source_refs" }
          }
        }
      }
    },
    "boot_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "location", "action", "confidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "pattern": "^(connector:.+-.+|pcb:.+)$", "description": "'connector:<connector>-<pin>' (a boot pin of this unit) or 'pcb:<label>'." },
        "action": { "$ref": "#/$defs/strap_action" },
        "resistor_ohms": { "type": "integer", "minimum": 1 },
        "note": { "type": ["string", "null"] },
        "confidence": { "$ref": "#/$defs/confidence", "description": "Not higher than access.boot.confidence." }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pins"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "pins": { "type": "array", "items": { "$ref": "#/$defs/pin" } }
      }
    },
    "pinref": { "type": "string", "pattern": "^.+-.+$", "description": "'<connector name>-<pin>'" },
    "bench": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes"],
      "properties": {
        "power": { "type": "array", "items": { "$ref": "#/$defs/pinref" } },
        "ground": { "type": "array", "items": { "$ref": "#/$defs/pinref" } },
        "ign": { "type": "array", "items": { "$ref": "#/$defs/pinref" } },
        "can_h": { "type": "array", "items": { "$ref": "#/$defs/pinref" } },
        "can_l": { "type": "array", "items": { "$ref": "#/$defs/pinref" } },
        "kline": { "type": "array", "items": { "$ref": "#/$defs/pinref" } },
        "boot": { "type": "array", "items": { "$ref": "#/$defs/pinref" } },
        "notes": { "type": "string", "minLength": 1 },
        "resistor_notes": { "type": ["string", "null"] }
      }
    }
  }
}
