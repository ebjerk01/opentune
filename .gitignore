# Rust build output (set CARGO_TARGET_DIR to build elsewhere)
/target
**/target
Cargo.lock.bak

# Node / Tauri / Android
node_modules/
desktop/dist/
desktop/src-tauri/target/
android/.gradle/
android/app/build/
android/local.properties
*.keystore
*.jks

# Proprietary vendor installers and any OEM/vendor binaries — NEVER publish
vendor/
*.exe
*.dll

# ECU firmware images / dumps — keep out of the repo
*.bin
# …except the committed synthetic demo fixtures (not real dumps — see samples/).
!/samples/*.bin
*.ori
*.mod
*.org
*.frf
*.odx
# hand-written synthetic test fixtures (no OEM data) are allowed
!crates/*/tests/fixtures/synthetic-*.odx
*.sgo
*.cbf
*.hex
*.s19
*.a2l
ecudumps/
backups/

# Claude Code session scaffolding (agent worktrees etc.)
.claude/

# Local notes, secrets, scratch
*-PRIVATE-*.md
.env
*.log
.DS_Store

# Local agent notes — not published
CLAUDE.md
